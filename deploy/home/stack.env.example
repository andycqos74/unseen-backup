# Variables for deploy/home/portainer-stack.yml.
# Copy, fill in, and load into Portainer ("Load variables from .env file").
# Contains secrets: don't commit the filled-in copy. Keep CB_KOPIA_PASSWORD
# in your password manager: without it every Kopia backup is unreadable.

# Image tag: main (default), or sha-<first 7 chars of a commit> to pin a build
CB_TAG=main

# Host folder for all server state (create it first, on the big disk)
CB_DATA_DIR=/srv/unseen-backup/data

# Agent-facing hostname (grey-cloud DNS, kept current by the ddns container)
CB_AGENT_HOST=agents.example.com
# Names/IPs in the server's TLS certificate: agent hostname + LAN IP
CB_SERVER_NAME=agents.example.com,192.168.1.50
# Baked into every installer, so set it before enrolling any agent
CB_PUBLIC_URL=https://agents.example.com:8443

# Admin GUI moved off the public port; browser address through the tunnel
CB_ADMIN_LISTEN=:8444
CB_ADMIN_URL=https://backup-admin.example.com

# Kopia repository password: openssl rand -hex 32
CB_KOPIA_PASSWORD=

# Cloudflare: tunnel token (only the part after --token) and an
# "Edit zone DNS" API token for DDNS
TUNNEL_TOKEN=
CLOUDFLARE_API_TOKEN=

TZ=Europe/London
